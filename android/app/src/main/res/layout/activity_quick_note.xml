<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickNoteBackdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/quickNoteCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/widget_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="✦ NOTE OF THE DAY"
                    android:textColor="#D4AF37"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quickNoteSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="From Pierre → Ebba"
                    android:textColor="#B4A899"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/quickNoteCloseBtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_refresh_bg"
                android:gravity="center"
                android:text="×"
                android:textColor="#E8DFD1"
                android:textSize="18sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/quickNoteInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/quick_note_input_bg"
            android:gravity="top|start"
            android:hint="Write a sweet note..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="240"
            android:maxLines="5"
            android:minLines="3"
            android:padding="14dp"
            android:textColor="#FAF7F2"
            android:textColorHint="#8E8477"
            android:textSize="15.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quickNoteCounter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 / 240"
                android:textColor="#9E9386"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/quickNoteCancelBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_refresh_bg"
                android:paddingLeft="14dp"
                android:paddingTop="8dp"
                android:paddingRight="14dp"
                android:paddingBottom="8dp"
                android:text="Cancel"
                android:textColor="#E8DFD1"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quickNoteSendBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/quick_note_send_bg"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp"
                android:text="Send ♥"
                android:textColor="#1A1613"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
